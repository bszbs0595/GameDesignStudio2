  - dialogueCharacter: {fileID: 11400000, guid: 594739f8966c2df448a76b1e601fe8b5, type: 2}
    sentence: Exactly. You have to believe me on this.
    skipDelayTime: 0
    sentenceSound: {fileID: 0}
    sentenceEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 0}
          m_TargetAssemblyTypeName: 
