  - dialogueCharacter: {fileID: 11400000, guid: 5cdb2de7568cd044ebb3d5de2ca40876, type: 2}
    sentence: And...this friend of yours... his name is Xiao Gua?"
    skipDelayTime: 0
    sentenceSound: {fileID: 0}
    sentenceEvent:
